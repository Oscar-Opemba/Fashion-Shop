# Copy to .env and fill in. Never commit .env.

# --- Django ---
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Add your ngrok host here when testing M-Pesa, e.g. https://abc123.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# --- Email (optional) ---
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD blank and nothing is sent —
# order receipts and password-reset links print to the console instead, which
# is what you want in development. Fill both in and real mail goes out.
#
# Use Gmail. Not because it is the best choice for transactional mail (it is
# not), but because it is the one PythonAnywhere's free tier will actually
# connect to. Tested from the live host:
#
#   smtp.gmail.com:587        open
#   smtp.sendgrid.net:587     connection refused
#   smtp-relay.brevo.com:587  connection refused
#
# EMAIL_HOST_PASSWORD must be a Google **App Password**, not your Google
# account password — a normal password is rejected outright.
#
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below. Spaces in it are fine, Google shows it
#      in groups of four; keep or strip them, both work.
#
# The App Password is equivalent to a password on that mailbox. Treat it like
# one: it belongs in .env (never committed) and nowhere else. Use a dedicated
# shop mailbox rather than your personal account, so revoking it later costs
# you nothing.
#
# Gmail sends about 500 messages a day on a free account and rewrites the From
# header to the authenticated mailbox whatever DEFAULT_FROM_EMAIL says.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional overrides — the defaults suit Gmail and most shops.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Fashion Shop <shop@example.com>
# CONTACT_EMAIL=            # where the contact form lands; defaults to the sender
# SITE_NAME=Fashion Shop    # appears in the receipt email

# --- Social login (optional) ---
# Leave a pair blank and that provider's button simply does not appear.
#
# Google — https://console.cloud.google.com/apis/credentials
#   Create Credentials -> OAuth client ID -> Web application.
#   Authorised redirect URI:
#     http://localhost:8000/accounts/google/login/callback/
#   (and the https equivalent for every domain you deploy to).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps
#   Add the "Facebook Login" product. The App ID is the client id, the
#   App Secret the client secret. Valid OAuth Redirect URI:
#     https://<your-domain>/accounts/facebook/login/callback/
#   Facebook requires https, so use the ngrok host when testing locally.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- M-Pesa Daraja (Lipa na M-Pesa Online / STK Push) ---
# Get these from https://developer.safaricom.co.ke:
#   1. Register and log in.
#   2. My Apps -> Add a new App, tick "Lipa Na M-Pesa Sandbox".
#      This gives you the Consumer Key and Consumer Secret.
#   3. APIs -> Lipa Na M-Pesa Online -> Simulate shows the sandbox
#      Shortcode (174379) and the Passkey.
#   4. That same page lists the sandbox test phone numbers and PIN.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# Which kind of shortcode MPESA_SHORTCODE is: `paybill` or `till`. The sandbox
# one is a Paybill. Getting this wrong makes Daraja reject every push, because
# a Paybill and a Buy Goods till take different transaction types.
MPESA_SHORTCODE_TYPE=paybill

# Who receives the money. Leave blank for a Paybill — it defaults to
# MPESA_SHORTCODE. Only set it for Buy Goods, where MPESA_SHORTCODE is the head
# office number and this is the till the money actually lands in.
MPESA_PARTY_B=

# Safaricom POSTs the payment result here, so it must be a public https url.
# In development: run `ngrok http 8000` and paste the forwarding url below.
MPESA_CALLBACK_BASE_URL=

# Random string that becomes part of the callback path. The callback cannot be
# authenticated, so an unguessable url is what keeps it from being spammed.
MPESA_CALLBACK_TOKEN=generate-a-random-string

MPESA_TRANSACTION_DESC=Online purchase


# --- Going live (real money) ---
# Sandbox pays Safaricom's shared test Paybill 174379, so nothing above moves
# real money no matter whose phone confirms the prompt. Taking actual payments
# needs three things from Safaricom, in this order:
#
#   1. An M-Pesa business account — a Paybill or a Buy Goods till. This is
#      business registration paperwork done with Safaricom, not a portal click.
#      A personal number cannot receive STK Push: Daraja requires a shortcode
#      for PartyB, so "pay me on 07xx..." is not a thing the API can express.
#      Your personal number comes in later, when you settle the business
#      account's balance out.
#   2. "Go Live" on https://developer.safaricom.co.ke — this issues production
#      Consumer Key, Consumer Secret and Passkey bound to that shortcode. The
#      sandbox credentials do not carry over.
#   3. Nothing else. The switch below is the whole change; daraja.py already
#      points at api.safaricom.co.ke whenever MPESA_ENV=production.
#
# Uncomment and fill in, keeping the sandbox values somewhere safe so you can
# switch back for demos:
#
# MPESA_ENV=production
# MPESA_CONSUMER_KEY=<production key, not the sandbox one>
# MPESA_CONSUMER_SECRET=<production secret>
# MPESA_PASSKEY=<production passkey for your shortcode>
#
# Then ONE of these two blocks, depending on what Safaricom issued you:
#
#   Paybill:
# MPESA_SHORTCODE=<your paybill number>
# MPESA_SHORTCODE_TYPE=paybill
# MPESA_PARTY_B=
#
#   Buy Goods till:
# MPESA_SHORTCODE=<your head office / store number>
# MPESA_SHORTCODE_TYPE=till
# MPESA_PARTY_B=<your till number>
#
# Test with the smallest amount the catalogue allows before announcing it —
# the first production push is the first time real money is at stake.
